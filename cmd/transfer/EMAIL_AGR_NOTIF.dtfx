fdffile=D:\com\share\mail_agr_notifications.fdfx

[SQL]
enablegroup=0
groupby=E1Z141Q2, LEFT(E1Z141Q2, 6), RIGHT(E1Z141Q2, 2), CONCAT(CONCAT(TM26A, TM27A), E1XX858), LEFT(E1XXDZE, 2), TRIM(E1XX84G), CASE WHEN TM45A IN ('T','E') THEN '16' ELSE '0' END, CASE WHEN LENGTH(TRIM(E1XX84W)) > 0 THEN 'Valid' ELSE 'Invalid' END
having=
joinby=
missingfields=0
orderby=
sqlselect=
select=E1Z141Q2 AS FECHA, LEFT(E1Z141Q2, 6) AS MESID, RIGHT(E1Z141Q2, 2) AS DIAID, CONCAT(CONCAT(TM26A, TM27A), E1XX858) AS UID, LEFT(E1XXDZE, 2) AS HORA, TRIM(E1XX84G) AS COLA, CASE WHEN TM45A IN ('T','E') THEN '16' ELSE '0' END AS RESPONSE, CASE WHEN LENGTH(TRIM(E1XX84W)) > 0 THEN 'Valid' ELSE 'Invalid' END AS VALIDCONT, count(*) AS ENVIOS
where=E1Z141Q2 >= '20260202' AND E1Z141Q2 <= '20260226'

