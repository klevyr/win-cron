[DataTransferFrom]
datatransferversion=1.0

[HostInfo]
database=*SYSBAS
hostfile=DVMCOMUN/TMSMT34U
hostname=AS400F35

[ClientInfo]
crtopt=1
outputdevice=2
savefdf=0
clientfiletype=12
clientfile=D:\com\share\mail_agr_notifications.csv
truncatetrailingspaces=1
padnumericfields=0
