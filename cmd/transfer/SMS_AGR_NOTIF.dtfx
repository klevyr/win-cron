[DataTransferFrom]
datatransferversion=1.0

[HostInfo]
database=*SYSBAS
hostfile=DVMCOMUN/TMSMT13U
hostname=AS400F35

[ClientInfo]
crtopt=1
outputdevice=2
savefdf=0
clientfiletype=12
clientfile=D:\com\share\sms_agr_notifications.csv
truncatetrailingspaces=1
padnumericfields=0
fileencoding=UTF-8
fdffile=D:\com\share\sms_agr_notifications.fdfx

[SQL]
enablegroup=0
groupby=S1Z141Q2, LEFT(S1Z141Q2, 6), RIGHT(S1Z141Q2, 2), CONCAT(CONCAT(TM26A, TM27A), S1XX858), LEFT(S1XXDZE, 2), TRIM(S1XX84G), LENGTH(TRIM(S1XX84A)), CASE WHEN TRIM(S1XX84W) LIKE '593%' THEN 'Valid' ELSE 'Invalid' END
having=
joinby=
missingfields=0
orderby=
sqlselect=
select=S1Z141Q2 AS FECHA, LEFT(S1Z141Q2, 6) AS MESID, RIGHT(S1Z141Q2, 2) AS DIAID, CONCAT(CONCAT(TM26A, TM27A), S1XX858) AS UID, LEFT(S1XXDZE, 2) AS HORA, TRIM(S1XX84G) AS COLA, LENGTH(TRIM(S1XX84A)) AS RESPONSE, CASE WHEN TRIM(S1XX84W) LIKE '593%' THEN 'Valid' ELSE 'Invalid' END AS VALIDCONT, count(*) AS ENVIOS
where=S1Z141Q2 >= '20260228' AND S1Z141Q2 <= '20260226'

