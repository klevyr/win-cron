[DataTransferFrom]
DataTransferVersion=1.0
[HostInfo]
Database=*SYSBAS
HostFile=DVMCOMUN/TMSMT13U
HostName=AS400F35
[ClientInfo]
CrtOpt=1
OutputDevice=2
SaveFDF=0
ClientFileType=12
ClientFile=D:\com\share\sms_agr_notifications.csv
TruncateTrailingSpaces=1
PadNumericFields=0
FileEncoding=UTF-8
FDFFile=D:\com\share\sms_agr_notifications.fdfx
[SQL]
EnableGroup=0
GroupBy=S1Z141Q2, LEFT(S1Z141Q2, 6), RIGHT(S1Z141Q2, 2), CONCAT(CONCAT(TM26A, TM27A), S1XX858), LEFT(S1XXDZE, 2), TRIM(S1XX84G), LENGTH(TRIM(S1XX84A)), CASE WHEN TRIM(S1XX84W) LIKE '593%' THEN 'Valid' ELSE 'Invalid' END, CASE WHEN LENGTH(TRIM(S1XX84Y)) = 13 AND RIGHT(TRIM(S1XX84Y), 3) = '001' THEN 'RUC' ELSE 'CID' END
Having=
JoinBy=
MissingFields=0
OrderBy=
SQLSelect=
Select=S1Z141Q2 AS FECHA, LEFT(S1Z141Q2, 6) AS MESID, RIGHT(S1Z141Q2, 2) AS DIAID, CONCAT(CONCAT(TM26A, TM27A), S1XX858) AS UID, LEFT(S1XXDZE, 2) AS HORA, TRIM(S1XX84G) AS COLA, LENGTH(TRIM(S1XX84A)) AS RESPONSE, CASE WHEN TRIM(S1XX84W) LIKE '593%' THEN 'Valid' ELSE 'Invalid' END AS VALIDCONT, CASE WHEN LENGTH(TRIM(S1XX84Y)) = 13 AND RIGHT(TRIM(S1XX84Y), 3) = '001' THEN 'RUC' ELSE 'CID' END TIPOID, count(*) AS ENVIOS
Where=TRIM(S1XX84W) NOT IN ('0','0000000000') AND S1Z141Q2 >= '20221201' AND S1Z141Q2 <= '20260309'
