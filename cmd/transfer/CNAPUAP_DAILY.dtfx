[DataTransferFrom]
DataTransferVersion=1.0
[HostInfo]
Database=*SYSBAS
HostFile=DVMCOMUN/CNAPUAP
HostName=AS400F35
[ClientInfo]
CrtOpt=1
OutputDevice=2
SaveFDF=0
ClientFileType=12
ClientFile=D:\com\share\cnapuap-daily.csv
TruncateTrailingSpaces=1
PadNumericFields=0
FileEncoding=windows-1252
[SQL]
EnableGroup=0
GroupBy=
Having=
JoinBy=
MissingFields=0
OrderBy=
SQLSelect=
Select=UADADM, UATIPU, UADUAD, trim(UANOMB) ||' '|| trim(UANOM2) ||' '|| trim(UAAPEL) ||' '|| trim(UAAPE2), UAMAIL, UATEL1, UATPUA, UAPWTR, UAUSBT, UAFEUT, UAHOUT, UAUSBD, UAFEEU, UAHOEU
Where=UADADM NOT LIKE '%PRU%' AND UADADM NOT LIKE 'GIFTCARD%'
[Options]
DateFmt=ISO
DateSep=[/]
DecimalSep=.
IgnoreDecErr=1
Lang=0
LangID=
SortSeq=0
SortTable=
TimeFmt=HMS
TimeSep=[:]
[HTML]
AutoSize=0
AutoSizeKB=128
CapAlign=0
CapIncNum=0
CapSize=6
Caption=
CellAlignN=0
CellAlignT=0
CellSize=6
CellWrap=1
Charset=windows-1252
ConvInd=0
DateTimeLoc=0
IncDateTime=0
OverWrite=1
RowAlignGenH=0
RowAlignGenV=0
RowAlignHdrH=0
RowAlignHdrV=0
TabAlign=0
TabBW=1
TabCP=1
TabCS=1
TabCols=2
TabRows=2
TabWidth=100
TabWidthP=0
Template=
TemplateTag=
Title=
UseTemplate=0
CapStyleDefault=1
CapStyleBold=0
CapStyleFixedWidth=0
CapStyleItalic=0
CapStyleUnderline=0
RowStyleHdrDefault=1
RowStyleHdrBold=0
RowStyleHdrFixedWidth=0
RowStyleHdrItalic=0
RowStyleHdrUnderline=0
RowStyleGenDefault=1
RowStyleGenBold=0
RowStyleGenFixedWidth=0
RowStyleGenItalic=0
RowStyleGenUnderline=0
EnableBorderWidth=0
EnableCellPadding=0
EnableCellSpacing=0
EnableNumberOfColumns=0
EnableNumberOfRows=0
EnableTableWidth=0
IncludeColumnNames=1
[Properties]
AutoClose=0
AutoRun=0
Check4Untrans=0
Convert65535=0
Notify=1
SQLStmt=0
ShowWarnings=0
StoreDecFAsChar=1
UseCompression=1
